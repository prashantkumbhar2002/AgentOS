# Environment variables for workflow service

# Database (for audit logging)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos

# Restate runtime URL
RESTATE_URL=http://localhost:8080

# AgentOS API URL (for policy checks, ticket creation)
AGENTOS_API_URL=http://localhost:3000

# LLM Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# Service Configuration
PORT=9080
NODE_ENV=development
LOG_LEVEL=info
