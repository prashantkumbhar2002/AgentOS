generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Environment {
  DEV
  STAGING
  PROD
}

enum AgentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  DEPRECATED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  AUTO_APPROVED
}

enum PolicyEffect {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TriggerType {
  MANUAL
  SCHEDULED
  WEBHOOK
  EVENT
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  SUSPENDED
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                String               @default("viewer")
  createdAt           DateTime             @default(now())
  approvals           ApprovalTicket[]     @relation("ResolvedBy")
  workflowDefinitions WorkflowDefinition[]
  workflowTriggers    WorkflowTrigger[]
}

model Agent {
  id                  String               @id @default(uuid())
  name                String
  description         String
  ownerTeam           String
  llmModel            String
  riskTier            RiskTier
  environment         Environment
  status              AgentStatus          @default(DRAFT)
  approvedBy          String?
  tags                String[]
  budgetUsd           Float?
  apiKeyHash          String?              @unique
  apiKeyHint          String?
  langsmithEnabled    Boolean              @default(false)
  langsmithProject    String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lastActiveAt        DateTime?
  tools               AgentTool[]
  auditLogs           AuditLog[]
  approvals           ApprovalTicket[]
  policies            AgentPolicy[]
  workflowDefinitions WorkflowDefinition[]
  workflowExecutions  WorkflowExecution[]
}

model AgentTool {
  id          String @id @default(uuid())
  agentId     String
  name        String
  description String
  agent       Agent  @relation(fields: [agentId], references: [id])
}

model AuditLog {
  id               String   @id @default(uuid())
  agentId          String
  traceId          String
  spanId           String?
  parentSpanId     String?
  event            String
  model            String?
  toolName         String?
  inputs           Json?
  outputs          Json?
  inputTokens      Int?
  outputTokens     Int?
  costUsd          Float?
  latencyMs        Int?
  success          Boolean  @default(true)
  errorMsg         String?
  metadata         Json?
  langsmithRunId   String?
  langsmithProject String?
  createdAt        DateTime @default(now())
  agent            Agent    @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@index([traceId])
  @@index([createdAt])
  @@index([event])
  @@index([spanId])
  @@index([langsmithRunId]) // Reverse-lookup: given a LangSmith run id, find the AgentOS audit row.
}

model ApprovalTicket {
  id           String         @id @default(uuid())
  agentId      String
  actionType   String
  payload      Json
  riskScore    Float
  reasoning    String
  status       ApprovalStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  expiresAt    DateTime
  slackMsgTs   String?
  createdAt    DateTime       @default(now())

  // Restate integration fields
  restateWorkflowId  String?
  restatePromiseName String?

  agent      Agent @relation(fields: [agentId], references: [id])
  resolvedBy User? @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([agentId])
  @@index([restateWorkflowId])
}

model Policy {
  id          String        @id @default(uuid())
  name        String        @unique
  description String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  rules       PolicyRule[]
  agents      AgentPolicy[]
}

model PolicyRule {
  id         String       @id @default(uuid())
  policyId   String
  actionType String
  riskTiers  RiskTier[]
  effect     PolicyEffect
  conditions Json?
  policy     Policy       @relation(fields: [policyId], references: [id])
}

model AgentPolicy {
  agentId  String
  policyId String
  agent    Agent  @relation(fields: [agentId], references: [id])
  policy   Policy @relation(fields: [policyId], references: [id])

  @@id([agentId, policyId])
}

// Workflow Management Models

model WorkflowDefinition {
  id          String         @id @default(uuid())
  name        String
  description String?
  version     String         @default("1.0.0")
  status      WorkflowStatus @default(DRAFT)

  // Workflow structure
  definition   Json // Full workflow definition (DAG: {nodes, edges} or legacy: {steps})
  isDag        Boolean @default(false) // true for DAG format, false for legacy sequential
  entryNodeId  String? // Entry node ID for DAG workflows
  inputSchema  Json? // JSON Schema for input validation
  outputSchema Json? // JSON Schema for output

  // Metadata
  agentId   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tags      String[]

  // Constraints
  maxCostUsd    Decimal? @db.Decimal(10, 4)
  maxDurationMs Int?

  // Stats
  executionCount Int @default(0)
  successCount   Int @default(0)
  failureCount   Int @default(0)

  // Relations
  agent      Agent               @relation(fields: [agentId], references: [id])
  user       User                @relation(fields: [createdBy], references: [id])
  triggers   WorkflowTrigger[]
  executions WorkflowExecution[]

  @@index([agentId])
  @@index([status])
  @@index([createdBy])
  @@index([isDag])
}

model WorkflowTrigger {
  id                   String      @id @default(uuid())
  workflowDefinitionId String
  name                 String
  description          String?
  type                 TriggerType
  enabled              Boolean     @default(true)

  // Schedule config (for SCHEDULED type)
  cronExpression String?
  timezone       String? @default("UTC")

  // Webhook config (for WEBHOOK type)
  webhookSecret String?
  webhookUrl    String? @unique

  // Event config (for EVENT type)
  eventType   String?
  eventFilter Json?

  // Input config
  defaultInput   Json?
  inputOverrides Json?

  // Metadata
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastTriggeredAt DateTime?
  triggerCount    Int       @default(0)

  // Relations
  workflowDefinition WorkflowDefinition  @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  user               User                @relation(fields: [createdBy], references: [id])
  executions         WorkflowExecution[]

  @@index([workflowDefinitionId])
  @@index([type, enabled])
  @@index([eventType])
}

model WorkflowExecution {
  id                   String                  @id @default(uuid())
  workflowId           String                  @unique // Restate workflow ID
  workflowDefinitionId String
  triggerId            String?
  agentId              String
  traceId              String
  status               WorkflowExecutionStatus @default(PENDING)

  // Execution data
  input  Json
  output Json?
  error  String?
  steps  Json? // Array of step statuses

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  // Cost tracking
  totalCostUsd Decimal? @db.Decimal(10, 6)

  // Restate integration
  restateInvocationId String?
  restateDeploymentId String?

  // Relations
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id])
  trigger            WorkflowTrigger?   @relation(fields: [triggerId], references: [id])
  agent              Agent              @relation(fields: [agentId], references: [id])

  @@index([workflowDefinitionId])
  @@index([status])
  @@index([startedAt])
  @@index([agentId])
  @@index([traceId])
}
